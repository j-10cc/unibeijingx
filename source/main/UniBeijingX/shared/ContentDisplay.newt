                local text:=if IsString(item) then item else if IsFrame(item) then item.item else nil;
                AddArraySlot(template.ubxTextItems,if IsString(text) then EnsureInternal(Clone(text)) else nil);
            end;
            foreach key in '[pickLeftMargin,pickRightMargin,pickTopMargin,pickMarkWidth,pickItemsMarkable] do
                if view.(key)<>nil then template.(key):=view.(key);
