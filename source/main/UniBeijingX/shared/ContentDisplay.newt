    pickerFonts:func(view) begin
        // Native clPickView has a single font for rows and private check-mark
        // glyphs. Render only Chinese text items as bitmap items, leaving the
        // Roman font, English rows, marks, indices and callback model intact.
        if view.viewClass mod 65536<>91 or view.ubxBitmapPicker or not IsArray(view.pickItems) then return nil;
        local context:=view.callbackContext;
        local font:=view.viewFont;
        local region:=GetGlobalVar('|ubxRegion:UBX|);
        local owned:=region and (region.countryPicker=view or (context=region and region.geoPicker=view));
        // Region's postal picker originally gives every row its CJK font,
        // including the English paging commands. Composite only that owned
        // picker with the ROM UI font; explicit user font choices stay intact.
        if owned then
            font:=1024*GetFontSize(font)+1048576*GetFontFace(font);
        // Postcode-only pages still contain English paging commands. They
        // need the same native Roman font even without a Chinese row.
