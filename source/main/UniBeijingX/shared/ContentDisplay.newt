                bounds:{left:box.left,top:box.top,right:box.left,bottom:box.top},
                callbackContext:nil,pickItems:nil,viewFont:font,
                pickTextItemHeight:height,pickAutoClose:true});
            // Internalize metadata without cloning the live callback view.
