// Integrated content/title fonts; no translated captions, locale or record writes.
DefGlobalVar('ubx52DisplayProto,{
    installFamilyMenu:func() begin
        self.familyMenuOriginal:=GetGlobalFn('GetAllFontFamilies);
        local callback:=Clone(self.familyMenu);callback.argFrame:=nil;
        self.familyMenuFn:=EnsureInternal(callback);
        DefGlobalFn('GetAllFontFamilies,self.familyMenuFn);
    end,
    familyMenu:func() begin
        local s:=GetGlobalVar('|ubxNamesContent:UBX|);
        if not s then return [];
        local families:=call s.familyMenuOriginal with ();
        if not fonts.beijing then return families;
        local result:=[];local system:=nil;
        foreach family in families do
            if family<>'|BeijingRegion:UBX| then begin
                AddArraySlot(result,family);if family='espy then system:=true;
            end;
        // Retain the package's existing System choice. The ROM metadata marks
        // Espy as an internal family, so its native enumerator omits it.
        if not system and fonts.espy then AddArraySlot(result,'espy);
        return result;
    end,
    removeFamilyMenu:func() begin
        if self.familyMenuFn and GetGlobalFn('GetAllFontFamilies)=self.familyMenuFn then
            DefGlobalFn('GetAllFontFamilies,self.familyMenuOriginal);
        self.familyMenuFn:=nil;self.familyMenuOriginal:=nil;
    end,
    refreshRegionalFonts:func() begin
        // A live view may cache the old private font independently of fonts.
        // Rebind only its font, retaining text/selection through setSlot.
        local queue:=GetRoot():ChildViewFrames();local index:=0;
        while index<Length(queue) and index<450 do begin
            local v:=queue[index];index:=index+1;
            if v.viewCObject then begin
                foreach slot in '[viewFont,entryFont] do begin
                    local f:=v.(slot);
                    if (IsFrame(f) or IsInteger(f)) and GetFontFamilySym(f)='|BeijingRegion:UBX| then begin
                        local main:=EnsureInternal({family:'beijing,size:GetFontSize(f),face:GetFontFace(f)});
                        self:setSlot(v,slot,main);self:setSlot(v,slot,f);
                    end;
                end;
                v:Dirty();
                if v.viewClass mod 65536<>81 then begin
                    local children:=v:ChildViewFrames();
                    if children then foreach c in children do if c.viewCObject then AddArraySlot(queue,c);
                end;
            end;
        end;
    end,
    shareRegionalFont:func() begin
        local owner:=GetGlobalVar('|ubxRegion:UBX|);
        local current:=fonts.|BeijingRegion:UBX|;
        if self.regionalOwner and self.regionalOwner<>owner then begin
            // Never dereference a saved bitmap after its Region was removed.
            self.regionalOwner:=nil;self.regionalOriginal:=nil;self.regionalShared:=nil;
        end;
        if not owner or owner.removing or not current or not fonts.beijing then return nil;
        if current.plainData=fonts.beijing.plainData then return nil;
        self.regionalOwner:=owner;self.regionalOriginal:=current;
        local metadata:=Clone(current);metadata.plainData:=nil;metadata.name:="UniBeijingX";
        if HasSlot(metadata,'tsid) then RemoveSlot(metadata,'tsid);
        metadata:=EnsureInternal(metadata);metadata.plainData:=fonts.beijing.plainData;
        self.regionalShared:=metadata;
        fonts.(EnsureInternal('|BeijingRegion:UBX|)):=metadata;
        self:refreshRegionalFonts();
    end,
    restoreRegionalFont:func() begin
        // Restore only this installation's alias while its owner still lives.
        if self.regionalOwner and self.regionalOwner=GetGlobalVar('|ubxRegion:UBX|) and
            fonts.|BeijingRegion:UBX|=self.regionalShared then begin
                fonts.(EnsureInternal('|BeijingRegion:UBX|)):=self.regionalOriginal;
                self:refreshRegionalFonts();
        end;
        self.regionalOwner:=nil;self.regionalOriginal:=nil;self.regionalShared:=nil;
    end,
    namesScope:func(view) begin
        local n:=0;
        while IsFrame(view) and view<>GetRoot() and n<14 do begin
            if view=GetRoot().cardfile or view.appSymbol='cardfile or
                view.theApp='cardfile or view.theApp=GetRoot().cardfile then return true;
            view:=view._parent;n:=n+1;
        end;
        return nil;
    end,
    nativeDateField:func(view) begin
        return IsFrame(view) and IsFunction(view.TextSetup) and IsFunction(view.MakePickLine);
    end,
    regionalSetFont:func(view,slot,group) begin
        local font:=GetGlobalVar('|ubxNamesContent:UBX|);
        if font and not font.removing and not self.removing and
            (font:namesScope(view) or slot='HourFont or (group='localeDisplay and slot='viewFont) or
                (slot='entryFont and font:nativeDateField(view))) then return nil;
        return self:|ubxNamesFontNative:UBX|(view,slot,group);
    end,
    nativeRegionalStyles:func(now,original,replacement,depth) begin
        // Undo font styles only. Current text, graphics and hit models may
        // already differ from the array saved by the Region package.
        if depth>5 then return nil;
        if IsArray(now) and IsArray(original) and IsArray(replacement) and
            Length(now)=Length(original) and Length(now)=Length(replacement) then begin
            local result:=nil;
            foreach i,item in now do begin
                local value:=self:nativeRegionalStyles(item,original[i],replacement[i],depth+1);
                if value then begin if not result then result:=Clone(now);result[i]:=value;end;
            end;
            return result;
        end;
        if IsFrame(now) and IsFrame(original) and IsFrame(replacement) and
            now.font and original.font and replacement.font and now.font=replacement.font then begin
            local result:=Clone(now);result.font:=self:romanFont(original.font);return result;
        end;
        return nil;
    end,
    prepareRegionalNames:func() begin
        local owner:=GetGlobalVar('|ubxRegion:UBX|);
        if self.namesHooks and self.namesHooks.owner<>owner then self.namesHooks:=nil;
        if not owner or owner.removing then return nil;
        if self.namesHooks and self.namesHooks.prepared then return nil;
        if not self.namesHooks then begin
            // Keep the frozen Region's labels, country/date filters and postal
            // callbacks. Its two font operations are superseded by our mixed
            // run renderer, so English retains the actual ROM family/face.
            local original:=owner.applyNames;
            if not IsFunction(original) or not IsArray(original.literals) then return nil;
            local method:=Clone(original);method.argFrame:=nil;method.literals:=Clone(original.literals);
            local found:=nil;
            foreach i,x in method.literals do if x='newyork then begin
                method.literals[i]:=EnsureInternal('|ubxUnmatchedFont:UBX|);found:=true;
            end;
            if not found then return nil;
            method:=EnsureInternal(method);
            self.namesHooks:={owner:owner,setOwn:HasSlot(owner,'setFontIn),setOriginal:owner.setFontIn,
                applyOwn:HasSlot(owner,'applyNames),applyOriginal:original,applyReplacement:method};
            owner.(EnsureInternal('|ubxNamesFontNative:UBX|)):=owner.setFontIn;
            owner.(EnsureInternal('setFontIn)):=self.regionalSetFontFn;
            owner.(EnsureInternal('applyNames)):=method;
        end;
        // Region may have been installed first, or opened an editor before
        // this font package. Restore its owned font replacements once, then
        // let paragraphFonts/drawingFonts route Chinese by character.
        for i:=Length(owner.changes)-1 to 0 by -1 do begin
            local c:=owner.changes[i];local view:=c.view;
            if view.viewCObject and (self:namesScope(view) or c.slot='HourFont or
                (c.group='localeDisplay and c.slot='viewFont) or
                (c.slot='entryFont and self:nativeDateField(view))) then begin
                if (c.slot='viewFont or c.slot='labelFont or c.slot='entryFont) and owner:ownsChange(c) then begin
                    self:setSlot(view,c.slot,self:romanFont(c.original));
                    if not c.own then RemoveSlot(view,c.slot);
                    if c.slot='entryFont and self:nativeDateField(view) then view:viewSetupChildrenScript();
                    if c.slot='labelFont and IsString(view.label) and view.SetLabelText then begin
                        SetValue(view,EnsureInternal('pix),nil);view:SetLabelText(view.label);
                    end;
                    RemoveSlot(owner.changes,i);
                end else if c.slot='shapeArray then begin
                    local value:=self:nativeRegionalStyles(view.shapeArray,c.original,c.replacement,0);
                    if value then SetValue(view,EnsureInternal('shapeArray),value);
                    RemoveSlot(owner.changes,i);
                end;
            end;
        end;
        self.namesHooks.prepared:=true;
    end,
    restoreRegionalNames:func() begin
        local h:=self.namesHooks;local owner:=GetGlobalVar('|ubxRegion:UBX|);
        if h and owner=h.owner and not owner.removing then begin
            if owner.setFontIn=self.regionalSetFontFn then begin
                if h.setOwn then owner.setFontIn:=h.setOriginal else RemoveSlot(owner,'setFontIn);
            end;
            if owner.applyNames=h.applyReplacement then begin
                if h.applyOwn then owner.applyNames:=h.applyOriginal else RemoveSlot(owner,'applyNames);
            end;
            if owner.|ubxNamesFontNative:UBX|=h.setOriginal then RemoveSlot(owner,'|ubxNamesFontNative:UBX|);
            owner:applyNames();
        end;
        self.namesHooks:=nil;
    end,
    baseFamily:func(family) begin
        foreach name in '[handwriting,newyork,simple,geneva,espy] do
            if family=name then return true;
        return nil;
    end,
    descriptor:func(font) begin
        if not IsInteger(font) and not IsFrame(font) then return nil;
        if IsFrame(font) and not IsSymbol(font.family) then return nil;
        local family:=GetFontFamilySym(font);
        // The extra Styles menu entries use ROM-only aliases, including
        // frame descriptors. Resolve those aliases only in content scopes;
        // leave the Roman registry and English-only paragraphs unchanged.
        if family='hand then family:='handwriting
        else if family='switzerland then family:='geneva
        else if family='USA then family:='newyork;
        if not self:baseFamily(family) then return nil;
        // Roman families retain their ROM registry metadata. Only fallback
        // runs use our bitmap; native menu frame descriptors stay native too.
        return EnsureInternal({family:'beijing,size:GetFontSize(font),face:GetFontFace(font),ubxRomanFamily:family});
    end,
    drawingFonts:func(pieces,depth,baseFont,fallbackFont) begin
        return self:styledDrawingFonts(pieces,depth,{font:baseFont},fallbackFont);
    end,
    styledDrawingFonts:func(pieces,depth,style,fallbackFont) begin
        if not IsArray(pieces) or depth>4 then return nil;
        local result:=nil;local current:=style;
        foreach i,piece in pieces do begin
            local value:=nil;
            if IsArray(piece) then value:=self:styledDrawingFonts(piece,depth+1,current,fallbackFont)
            else if IsFrame(piece) then begin
                if not piece.class and (piece.font or HasSlot(piece,'transferMode) or HasSlot(piece,'justification) or
                    HasSlot(piece,'fillPattern) or HasSlot(piece,'penPattern)) then begin
                    current:=Clone(style);foreach key,item in piece do current.(key):=item;
                    if piece.font then begin
                        local roman:=self:romanFont(piece.font);
                        if roman<>piece.font then begin value:=Clone(piece);value.font:=roman;end;
                    end;
                end else if piece.class='text and current.font then
                    value:=self:styledTextDrawing(piece,current.font,fallbackFont,current);
            end;
            if value then begin
                if not result then result:=Clone(pieces);
                result[i]:=value;
            end;
        end;
        return result;
    end,
    textDrawing:func(shape,font,fallbackFont) begin
        return self:styledTextDrawing(shape,font,fallbackFont,{font:font});
    end,
    styledTextDrawing:func(shape,font,fallbackFont,style) begin
        local family:=GetFontFamilySym(font);
        if family='beijing or family='|BeijingRegion:UBX| then return nil;
        local fallback:=if fallbackFont then fallbackFont else self:uiFont(font,nil);
        if not fallback then return nil;
        local info:=GetShapeInfo(shape);local text:=info.text;
        local part:=GetGlobalVar('|ubxFontPart:UBX|);
        if not IsString(text) or not part:containsChinese(text) then return nil;
        local roman:=self:romanFont(font);local bounds:=info.bounds;
        if self.overviewRight and bounds.right>bounds.left then begin
            if not fallbackFont then fallback:=self:uiFont(font,bounds.bottom-bounds.top);
            local limit:=Min(bounds.right,self.overviewRight)-bounds.left;local cut:=StrLen(text);
            local width:=self:mixedWidth(text,roman,fallback);
            if EndsWith(text,"...") then cut:=cut-3;
            while cut>0 and width>limit do begin
                cut:=cut-1;text:=SubStr(info.text,0,cut)&"...";
                width:=self:mixedWidth(text,roman,fallback);
            end;
        end;
        local runs:=[];local offset:=0;local total:=0;
        while offset<StrLen(text) do begin
            local start:=offset;local chinese:=part:displayCode(Ord(text[offset]));offset:=offset+1;
            while offset<StrLen(text) and (part:displayCode(Ord(text[offset])))=chinese do offset:=offset+1;
            local run:=SubStr(text,start,offset-start);local f:=if chinese then fallback else roman;
            local width:=StrFontWidth(run,f);AddArraySlot(runs,{text:run,font:f,width:width});total:=total+width;
        end;
        local x:=bounds.left;
        if style.justification='center then x:=x+(bounds.right-bounds.left-total) div 2
        else if style.justification='right then x:=bounds.right-total;
        local pieces:=[];
        foreach run in runs do begin
            local drawing:=Clone(style);drawing.font:=run.font;drawing.justification:='left;
            AddArraySlot(pieces,drawing);
            AddArraySlot(pieces,MakeText(run.text,x,bounds.top,x+run.width+1,bounds.bottom));x:=x+run.width;
        end;
        local restore:=Clone(style);restore.font:=roman;AddArraySlot(pieces,restore);
        // Native containers may clone/cache this drawing list after our undo
        // record was taken. Own every style key, symbol and shape independently
        // of the removable package, not only the font descriptors.
        return EnsureInternal(pieces);
    end,
    contentScope:func(view) begin
        local depth:=0;
        while IsFrame(view) and view<>GetRoot() and depth<14 do begin
            foreach app in '[cardfile,calendar,paperroll] do
                if view=GetRoot().(app) or view.theApp=app or view.theApp=GetRoot().(app) or view.appSymbol=app then return true;
            view:=view._parent;depth:=depth+1;
        end;
        return nil;
    end,
    quickScope:func(view) begin
        if not view or view._parent<>GetRoot() or not view.headerText or not view.infoText or
            not IsFrame(view.targetView) or not IsInteger(view.extraHeight) then return nil;
        // Some ROMs expose a target belonging directly to the owning app.
        local target:=view.targetView;
        if self:quickOwnerScope(target) then return true;
        // On 712000 targetView is a different NS wrapper for the quick slip's
        // own native view, not the requesting picker. Require that exact native
        // identity and the immediately preceding live, typed picker. An
        // arbitrary Names picker elsewhere in the root list is insufficient.
        if target.viewCObject<>view.viewCObject then return nil;
        local previous:=nil;
        foreach root in GetRoot():ChildViewFrames() do if root.viewCObject then begin
            if root.viewCObject=view.viewCObject then begin
                if previous and self:selectorClass(previous.dataClass) and IsFrame(previous.context) and
                    self:quickOwnerScope(previous.context) then return true;
                return nil;
            end;
            previous:=root;
        end;
        return nil;
    end,
    quickOwnerScope:func(view) begin
        local depth:=0;
        while IsFrame(view) and view<>GetRoot() and depth<14 do begin
            foreach app in '[cardfile,calendar] do
                if view=GetRoot().(app) or view.theApp=app or view.theApp=GetRoot().(app) or view.appSymbol=app then return true;
            view:=view._parent;depth:=depth+1;
        end;
        return nil;
    end,
    rememberDisplay:func(view,slot,value) begin
        local record:=nil;
        foreach c in self.changes do if c.view=view and c.slot=slot then record:=c;
        if record then begin
            if view.(slot)<>record.replacement then begin record.original:=view.(slot);record.own:=HasSlot(view,slot);end;
            record.replacement:=value;record.display:=true;
        end else AddArraySlot(self.changes,{view:view,slot:EnsureInternal(slot),own:HasSlot(view,slot),
            original:view.(slot),replacement:value,display:true});
        // Native quick-entry filters must not receive a second text assignment
        // merely because their renderer's font changed. Keep text and selection.
        SetValue(view,EnsureInternal(slot),value);view:Dirty();
    end,
    fontSlot:func(view,slot) begin
        if not view or not view.viewCObject then return nil;
        local value:=if (view.viewClass mod 65536=98 or view.viewClass mod 65536=76) and slot='viewFont then
            self:uiFont(view.(slot),view:LocalBox().bottom) else self:descriptor(view.(slot));
        if value then self:rememberDisplay(view,slot,value);
    end,
    uiFont:func(font,height) begin
        local f:=self:descriptor(font);if not f then return nil;
        f:=Clone(f);f.ubxUIRomanFont:=self:romanFont(font);
        // Synthetic one-pixel bold closes the gaps of 9/10px CJK glyphs.
        // UI data stays readable in regular weight; Roman runs keep ROM bold.
        if f.size<=10 then f.face:=f.face-f.face mod 2;
        if height and FontHeight(f)>height then foreach point in [18,16,14,12,10,9] do
            if point<f.size and FontHeight(f)>height then f.size:=point;
        return EnsureInternal(f);
    end,
    quickFonts:func(root) begin
        if not self:quickScope(root) then return nil;
        local queue:=[root];local index:=0;
        while index<Length(queue) and index<60 do begin
            local view:=queue[index];
            if view.viewCObject and view.viewClass=81 and view.preallocatedContext='entryLine then
                self:paragraphFonts(view);
            foreach child in view:ChildViewFrames() do if child.viewCObject then AddArraySlot(queue,child);
            index:=index+1;
        end;
    end,
    findScope:func(root) begin
        if root.appSymbol<>'findOverview or not IsArray(root.findAllResults) then return nil;
        // The native Find renderer is shared by all result owners. Resolve its
        // draw styles even when Calls or another application joins the search;
        // leave every owner's records, results and callbacks in place.
        return true;
    end,
    findQueryFonts:func(root) begin
        // Only the native global Find drawer's query, including when Calendar
        // is closed. Do not discover unrelated controls by their English label.
        if root.preallocatedContext='findDrawer and root.debug=33484 and
            root.findInput and root.findInput.viewCObject and
            root.findInput.preallocatedContext='findInput then
                self:paragraphFonts(root.findInput.entryLine);
    end,
    romanFont:func(font) begin
        if not IsFrame(font) or not IsSymbol(font.family) then return font;
        local family:=font.family;local i:=0;
        if family='hand then family:='handwriting
        else if family='switzerland then family:='geneva
        else if family='USA then family:='newyork;
        foreach name in '[espy,newyork,geneva,handwriting] do begin
            if family=name then return i+1024*GetFontSize(font)+1048576*GetFontFace(font);
            i:=i+1;
        end;
        return font;
    end,
    nativeKeyFont:func(view) begin
        if not IsFrame(view) or not view.viewCObject or view.viewClass mod 65536<>98 or
            not view.ButtonClickScript or not IsString(view.text) or
            GetGlobalVar('|ubxFontPart:UBX|):containsChinese(view.text) then return nil;
        // Native New uses an Espy 9pt Bold frame. Its family lookup would
        // otherwise follow our content bitmap alias. A packed ROM spec keeps
        // the same family, size and face without changing caption or callback.
        local font:=self:romanFont(view.viewFont);
        if IsInteger(font) and font<>view.viewFont then begin
            self:remember(view,EnsureInternal('viewFont),font);
            // Standard key bars measure their children before they open.
            // Recalculate the cached width with the native routine and the
            // restored Roman font; sibling justification follows that width.
            local bar:=view._parent;
            if view.keyButton and bar and bar.CalcWidth then begin
                local width:=bar:CalcWidth(view);local bounds:=view.viewBounds;
                if IsInteger(width) and width>0 and bounds.right-bounds.left<>width then begin
                    bounds:=Clone(bounds);bounds.right:=bounds.left+width;
                    // This is a native layout cache, not a user setting.
                    // Keep the ROM-measured cache when restoring the original
                    // font; the replaced-font width would be stale on unload.
                    self:setSlot(view,EnsureInternal('viewBounds),bounds);
                end;
            end;
        end;
    end,
    nativeKeyFonts:func() begin
        foreach name in '[paperroll,cardfile,calendar,callapp] do begin
            local app:=GetRoot().(name);
            if app and app.viewCObject then begin
                if name='calendar then begin
                    if app.statusBar then begin
                        self:nativeKeyFont(app.statusBar.newButton);
                        self:nativeKeyFont(app.statusBar.ShowButton);
                    end;
                end else begin
                    // Standard key buttons belong directly to the app or to
                    // its native status bar. Do not adapt arbitrary captions.
                    foreach bar in app:ChildViewFrames() do if bar.viewCObject then begin
                        foreach key in '[_newKeyButton,_addKeyButton,_showKeyButton] do
                            if bar.keyButton=key then self:nativeKeyFont(bar);
                        // Standard status bars contain the remaining keys.
                        // Inspecting editor/layout children here can enter an
                        // inactive native text view while another slip owns it.
                        if bar.preallocatedContext='status or bar.preallocatedContext='statusBar then
                            foreach button in bar:ChildViewFrames() do
                                if button.viewCObject then
                                    foreach key in '[_newKeyButton,_addKeyButton,_showKeyButton] do
                                        if button.keyButton=key then self:nativeKeyFont(button);
                    end;
                end;
            end;
        end;
    end,
    runFonts:func(styles,text) begin
        if not IsArray(styles) or Length(styles) mod 2<>0 then return nil;
        local result:=nil;
        if IsString(text) then begin
            local runs:=[];local offset:=0;local changed:=nil;
            local part:=GetGlobalVar('|ubxFontPart:UBX|);
            for index:=0 to Length(styles)-2 by 2 do begin
                local count:=styles[index];local original:=styles[index+1];
                if not IsInteger(count) or count<0 or offset+count>StrLen(text) then return nil;
                local after:=offset+count;
                local automatic:=IsFrame(original) and original.family='beijing and original.ubxRomanFamily;
                local display:=if automatic then original else self:descriptor(original);
                local roman:=if automatic then self:romanFont({family:original.ubxRomanFamily,
                    size:GetFontSize(original),face:GetFontFace(original)}) else self:romanFont(original);
                if not display and roman=original then begin
                    AddArraySlot(runs,count);AddArraySlot(runs,original);offset:=after;
                end else begin
                while offset<after do begin
                    local start:=offset;local cjk:=part:displayCode(Ord(text[offset]));offset:=offset+1;
                    while offset<after and (part:displayCode(Ord(text[offset])))=cjk do offset:=offset+1;
                    local font:=if cjk then display else roman;
                    if not font then font:=original;
                    if font<>original or offset-start<>count then changed:=true;
                    AddArraySlot(runs,offset-start);AddArraySlot(runs,font);
                end;
                if count=0 then begin AddArraySlot(runs,0);AddArraySlot(runs,original);end;
                end;
            end;
            return if changed then runs else nil;
        end;
        // Native paragraph runs alternate character counts and fonts. Never
        // interpret a character count as a font or flatten mixed formatting.
        for index:=1 to Length(styles)-1 by 2 do begin
            local font:=self:descriptor(styles[index]);
            if font then begin
                if not result then result:=Clone(styles);
                result[index]:=font;
            end;
        end;
        return result;
    end,
    paragraphFonts:func(root) begin
        if not root or not root.viewCObject then return nil;
        local queue:=[root];local index:=0;
        while index<Length(queue) and index<300 do begin
            local view:=queue[index];
            if view.viewCObject then begin
                if view.viewClass mod 65536=81 then begin
                    if IsString(view.text) then begin
                            // Setting a paragraph's default font can reformat
                            // its explicit runs. With mixed text, resolve the
                            // runs themselves and leave that default alone.
                            if IsArray(view.styles) and Length(view.styles)>0 then begin
                                local styles:=self:runFonts(view.styles,view.text);
                                if styles then self:rememberDisplay(view,'styles,styles);
                            end else if GetGlobalVar('|ubxFontPart:UBX|):containsChinese(view.text) and
                                (not view.textFlags or view.textFlags mod 16<8) then begin
                                // Fresh Notes paragraphs have no explicit run
                                // array. Introduce display runs here as well,
                                // keeping Roman glyphs on the original font.
                                local styles:=self:runFonts([StrLen(view.text),view.viewFont],view.text);
                                if styles then self:rememberDisplay(view,'styles,styles);
                            end else if GetGlobalVar('|ubxFontPart:UBX|):containsChinese(view.text) then
                                self:fontSlot(view,'viewFont)
                            else if IsFrame(view.viewFont) and view.viewFont.ubxRomanFamily then
                                self:rememberDisplay(view,'viewFont,self:romanFont({family:view.viewFont.ubxRomanFamily,
                                    size:GetFontSize(view.viewFont),face:GetFontFace(view.viewFont)}));
                        end;
                end else begin
                    local children:=view:ChildViewFrames();
                    if children then foreach child in children do
                        if child.viewCObject then AddArraySlot(queue,child);
                end;
            end;
            index:=index+1;
        end;
    end,
    overviewRomanFont:func(font) begin
        if IsFrame(font) and font.family='beijing and font.ubxRomanFamily then
            return self:romanFont({family:font.ubxRomanFamily,size:GetFontSize(font),face:GetFontFace(font)});
        return self:romanFont(font);
    end,
    overviewNativeStyles:func(pieces,depth) begin
        if not IsArray(pieces) or depth>4 then return pieces;
        local result:=nil;
        foreach i,piece in pieces do begin
            local value:=piece;
            if IsArray(piece) then value:=self:overviewNativeStyles(piece,depth+1)
