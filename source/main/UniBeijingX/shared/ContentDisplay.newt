    overviewFonts:func(view) begin
        if not view or not view.viewCObject then return nil;
        local method:=view.Abstract;
        if not IsFunction(method) or not IsArray(method.literals) then return nil;
        local literals:=method.literals;
        // Keep the native extraction, icon, selection and geometry. Adapt the
        // returned drawing list by character, rather than changing the whole
        // title font and degrading Roman-only rows.
        if Length(literals)<>31 or Length(method.instructions)<>461 or
            method.numArgs<>458754 or literals[0]<>'hiliteEntry or
            literals[12]<>'MakeText or literals[30]<>'StrTruncate then return nil;
        local changed:=nil;
