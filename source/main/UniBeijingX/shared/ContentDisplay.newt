            // Closing the old native month popup sends its cancel callback,
            // which clears the label's source array. The original action reads
            // that array's inc values; keep it for the replacement's callback.
            local source:=if context then context.popup else nil;
            local hilite:=if context then context.hilite else nil;
            local cancel:=if context then context.PickCancelledScript else nil;
            local ownCancel:=context and HasSlot(context,'PickCancelledScript);
            if context then context.(EnsureInternal('PickCancelledScript)):=self.pickerCancelFn;
            local failure:=nil;
            try view:Close() onexception |evt.ex| do failure:=CurrentException();
