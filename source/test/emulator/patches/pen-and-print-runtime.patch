@@ -468,6 +477,71 @@ public:
 		((Fl_Newton_Screen_Widget*) me)->penDownTimer();
 	}
 
+	static void
+	penCommandUpCB(void* me)
+	{
+		auto* self = (Fl_Newton_Screen_Widget*) me;
+		self->screenManager_->PenUp();
+		fprintf(stderr, "UBX pen up\n");
+	}
+
+	static void
+	penCommandTimerCB(void* me)
+	{
+		auto* self = (Fl_Newton_Screen_Widget*) me;
+		FILE* input = fopen(self->penCommandFile, "r");
+		if (input)
+		{
+			char line[1024] = { 0 };
+			fgets(line, sizeof(line), input);
+			int x = -1, y = -1;
+			int parsed = sscanf(line, "%d %d", &x, &y);
+			fclose(input);
+			remove(self->penCommandFile);
+			if (strncmp(line, "SHOT ", 5) == 0)
+			{
+				std::string path(line + 5);
+				while (!path.empty() && (path.back() == '\n' || path.back() == '\r'))
+					path.pop_back();
+				if (!path.empty())
+				{
+					int result = self->screenManager_->TakeSnapshot(path);
+					fprintf(stderr, "UBX snapshot %s result %d\n", path.c_str(), result);
+				}
+			}
+			else if (strncmp(line, "PKG ", 4) == 0)
+			{
+				std::string path(line + 4);
+				while (!path.empty() && (path.back() == '\n' || path.back() == '\r'))
+					path.pop_back();
+				if (!path.empty())
+				{
+					self->mApp->InstallPackagesFromURI(path.c_str());
+					fprintf(stderr, "UBX install package %s\n", path.c_str());
+				}
+			}
+			else if (strncmp(line, "NS ", 3) == 0)
+			{
+				// Existing Einstein evaluator accepts at most 255 source bytes.
+				if (strlen(line + 3) < 256)
+					self->mApp->GetPlatformManager()->EvalNewtonScript(line + 3);
+			}
+			else if (strncmp(line, "REBOOT", 6) == 0)
+			{
+				self->mApp->UserActionReset(1);
+				fprintf(stderr, "UBX NewtonScript reboot\n");
+			}
+			else if (parsed == 2 && x >= 0 && y >= 0 &&
+				x < self->rgbWidth_ && y < self->rgbHeight_)
+			{
+				self->screenManager_->PenDown(x, y);
+				fprintf(stderr, "UBX pen down %d %d\n", x, y);
+				Fl::add_timeout(0.12, penCommandUpCB, self);
+			}
+		}
+		Fl::repeat_timeout(0.05, penCommandTimerCB, self);
+	}
+
 	int
 	handle(int event) override
 	{
