        StuffByte(bits,4,bytes div 256);StuffByte(bits,5,bytes mod 256);
        StuffByte(bits,12,height div 256);StuffByte(bits,13,height mod 256);
        StuffByte(bits,14,(width+1) div 256);StuffByte(bits,15,(width+1) mod 256);
        for i:=0 to bytes*height-1 do StuffByte(bits,16+i,ExtractByte(info.bits,info.scanOffset+i));
