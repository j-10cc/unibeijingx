    folderTitleFont:func(view) begin
        if view.preallocatedContext<>'showBarText or view.viewClass mod 65536<>98 or
            not IsString(view.text) or not self:descriptor(view.viewFont) then return nil;
        if view.ViewDrawScript<>self.folderTitleFn then begin
            if not GetGlobalVar('|ubxFontPart:UBX|):containsChinese(view.text) then return nil;
            local method:=view.ViewDrawScript;
            // Keep the ROM's own end caps, click scripts and title model.
            if not IsFunction(method) or not IsArray(method.literals) or Length(method.literals)<>5 or
                method.literals[0]<>'leftBits or method.literals[1]<>'CopyBits or
                method.literals[2]<>'rightBits or method.literals[3]<>'width then return nil;
            self:rememberDisplay(view,'|ubxFolderChrome:UBX|,method);
            self:rememberDisplay(view,'ubxFolderPadding,Max(0,view.width-StrFontWidth(view.text,view.viewFont)));
            self:rememberDisplay(view,'|ubxFolderSetup:UBX|,view.ViewSetupFormScript);
            self:rememberDisplay(view,'ViewSetupFormScript,self.folderSetupFn);
            self:rememberDisplay(view,'ViewDrawScript,self.folderTitleFn);
            view:Close();view:Open();
        end;
        // RedoText runs during native setup and owns the bounds cache. Resize
        // during that setup, before the C view reads the new right anchor.
        if view:LocalBox().right<>self:folderTitleWidth(view,view:LocalBox().bottom) then begin
            view:Close();view:Open();
        end;
