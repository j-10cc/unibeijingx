            end;
        end;
        if result then begin
            // Own every displayed string, including English labels supplied
            // by the removable Region, while retaining each item's metadata.
            foreach i,item in result do
                if IsString(item) then result[i]:=EnsureInternal(Clone(item))
                else if IsFrame(item) and IsString(item.item) then begin
                    local copy:=Clone(item);copy.item:=EnsureInternal(Clone(item.item));result[i]:=copy;
                end;
            // DoPopup's native-only view has no editable NS template. Writing
            // pickItems into its wrapper does not rebuild the native row cache.
            // Recreate that one popup with the public protoPicker, giving it
            // the same rows, callback context, marks and font before Open.
            local box:=view:GlobalBox();
