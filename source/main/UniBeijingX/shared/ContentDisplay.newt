        if not IsInteger(height) or height<1 then height:=FontHeight(font);
        local fallback:=self:uiFont(font,nil);
        if fallback then begin
            // Reserve room for native row margins and the bottom border too.
            height:=Max(height,FontHeight(fallback)+6);
        end;
        foreach i,item in view.pickItems do begin
            local text:=if IsString(item) then item else if IsFrame(item) then item.item else nil;
            if IsString(text) and GetGlobalVar('|ubxFontPart:UBX|):containsChinese(text) then begin
                local bitmap:=self:pickerBitmap(text,font,height);
                if bitmap then begin
