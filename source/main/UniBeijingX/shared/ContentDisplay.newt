    folderTitleWidth:func(view,height) begin
        return self:folderTitleInfo(view,height).width;
    end,
    folderTitleInfo:func(view,height) begin
        local parent:=view._parent;local parentWidth:=parent:LocalBox().right;
        local right:=view.viewBounds.right;if right<=0 then right:=parentWidth+right;
        local clock:=parent.title;local edge:=0;
        if IsFrame(clock) and clock.preallocatedContext='title and clock.viewTransferMode=modeBIC then begin
            edge:=if clock.viewCObject then clock:GlobalBox().right-parent:GlobalBox().left
                else clock.viewBounds.right;
            if edge<0 then edge:=parentWidth+edge;
        end;
        local limit:=Max(24,right-edge-2);local padding:=Max(12,view.ubxFolderPadding);
        local fallback:=self:uiFont(view.viewFont,height);local text:=view.text;
        local width:=self:mixedWidth(text,view.viewFont,fallback);local cut:=StrLen(text);
        if EndsWith(text,"...") then cut:=cut-3;
        while cut>1 and width+padding>limit do begin
            cut:=cut-1;text:=SubStr(view.text,0,cut)&"...";
            width:=self:mixedWidth(text,view.viewFont,fallback);
        end;
        return {text:text,width:width+padding};
    end,
    mixedWidth:func(text,font,fallback) begin
        local part:=GetGlobalVar('|ubxFontPart:UBX|);local width:=0;local i:=0;
        while i<StrLen(text) do begin
            local start:=i;local chinese:=part:displayCode(Ord(text[i]));i:=i+1;
            while i<StrLen(text) and part:displayCode(Ord(text[i]))=chinese do i:=i+1;
            width:=width+StrFontWidth(SubStr(text,start,i-start),
                if chinese then fallback else self:romanFont(font));
        end;
        // ROM fallback widths can leave no padding for an unsupported CJK
        // title. Reserve both rounded caps independently of that estimate.
