    end,
    configValueFonts:func(value) begin
        if not value or not value.viewCObject or not IsString(value.text) then return nil;
        if not GetGlobalVar('|ubxFontPart:UBX|):containsChinese(value.text) then begin
            for i:=Length(self.changes)-1 to 0 by -1 do begin
                local c:=self.changes[i];
                if c.view=value and c.configValue then begin
                    self:restoreChange(c,nil);RemoveSlot(self.changes,i);
                end;
            end;
            return nil;
        end;
        // Read-only config values ignore paragraph run styles in their native
        // text cache. Their entire value can use fallback when it is Chinese;
        // native English is restored as soon as the config value changes.
        local font:=self:uiFont(value.viewFont,value:LocalBox().bottom);
        if font then begin
            self:rememberDisplay(value,'viewFont,font);
            foreach c in self.changes do if c.view=value and c.slot='viewFont then c.configValue:=true;
            self:setSlot(value,'viewFont,font);
        end;
    end,
    sharedTextFonts:func() begin
        // User data also appears in shared system slips (notably Folder Name,
        // filing rows and Owner Info), outside the three content app trees.
        // Pure Roman text and captions keep their existing fonts and shapes.
        local queue:=GetRoot():ChildViewFrames();local i:=0;
        while i<Length(queue) and i<700 do begin
            local view:=queue[i];i:=i+1;
            self.sharedIndex:=i;self.sharedClass:=nil;self.sharedOperation:='liveness;
            self.sharedRootRole:=if view=GetRoot().calendar then 'calendarRoot
                else if view=GetRoot().paperroll then 'notesRoot
                else if view=GetRoot().paperroll.layout then 'notesLayout
                else if view=GetRoot().buttons then 'buttons
                else if view=GetRoot().notifyIcon then 'notifyIcon else 'other;
            if view.viewCObject then begin
                local kind:=view.viewClass mod 65536;
                self.sharedClass:=kind;self.sharedOperation:='paragraph;
                if kind=81 then begin
                    self:paragraphFonts(view);
                    // Compound labels (Country in Locale, for example) are
                    // paragraphs whose value is a separate entryLine. Inspect
                    // that value explicitly without walking native text internals.
                    if view.entryLine and view.entryLine<>view and view.entryLine.viewCObject then
                        if view.RebuildIndexes and IsArray(view.configPath) then self:configValueFonts(view.entryLine)
                        else self:paragraphFonts(view.entryLine);
                end else begin
                    self.sharedOperation:='folderTitle;
                    if kind=98 then self:folderTitleFont(view);
                    self.sharedOperation:='radio;
                    if kind=76 then self:radioTextFont(view);
                    self.sharedOperation:='textFont;
                    if kind=98 and IsString(view.text) and view.ViewDrawScript<>self.folderTitleFn and
                        not (view.preallocatedContext='title and view.viewTransferMode=modeBIC) then begin
                        if GetGlobalVar('|ubxFontPart:UBX|):containsChinese(view.text) then self:fontSlot(view,'viewFont)
                        else if IsFrame(view.viewFont) and view.viewFont.ubxRomanFamily then
                            self:rememberDisplay(view,'viewFont,if view.viewFont.ubxUIRomanFont then view.viewFont.ubxUIRomanFont
                                else self:romanFont({family:view.viewFont.ubxRomanFamily,
                                    size:GetFontSize(view.viewFont),face:GetFontFace(view.viewFont)}));
                    end;
                    foreach slot in '[pieces,shapeArray,pix] do begin
                        self.sharedOperation:=slot;
                        if IsArray(view.(slot)) then begin
                            local pieces:=self:drawingFonts(view.(slot),0,view.viewFont,nil);
                            if pieces then self:rememberDisplay(view,slot,pieces);
                        end;
                    end;
                    self.sharedOperation:='children;
                    foreach child in view:ChildViewFrames() do if child.viewCObject then AddArraySlot(queue,child);
                end;
            end;
        end;
    end,
    datePickerFonts:func() begin
        // Month-view labels are drawn by native controls, not child text
        // paragraphs. Repeat Other embeds the same picker inside Calendar;
        // external-popup-only traversal misses its month and weekday labels.
        // Keep day numbers, English captions, callbacks and date selection.
        if GetLocale().localeSym<>'|zhCN:Beijing| then begin
            for i:=Length(self.changes)-1 to 0 by -1 do if self.changes[i].datePicker then begin
                self:restoreChange(self.changes[i],nil);RemoveSlot(self.changes,i);
            end;
            return nil;
        end;
        local queue:=GetRoot():ChildViewFrames();local index:=0;
        while index<Length(queue) and index<450 do begin
            local view:=queue[index];index:=index+1;
            if view.viewCObject then begin
                if view.viewClass mod 65536=clMonthView then self:datePickerSlot(view,'labelFont);
                if view.monthView and view.monthView.viewCObject and
                    view.monthView.viewClass mod 65536=clMonthView and view.monthYearLabel and view.SetTitle then begin
                    self:datePickerSlot(view,'titleFont);self:datePickerSlot(view,'labelFont);
                    if IsString(view.monthYearLabel.text) and
                        GetGlobalVar('|ubxFontPart:UBX|):containsChinese(view.monthYearLabel.text) then
                        self:datePickerSlot(view.monthYearLabel,'viewFont);
                end;
                if view.viewClass mod 65536<>81 then begin
                    local children:=view:ChildViewFrames();
                    if children then foreach child in children do if child.viewCObject then AddArraySlot(queue,child);
                end;
            end;
        end;
    end,
    applyDisplay:func() begin
        if not self.displayEnabled then return nil;
        self.phase:='closePickers;
        self:closeBitmapPickers(nil);
        self.phase:='sharedText;
        self:sharedTextFonts();
        self.phase:='datePickers;
        self:datePickerFonts();
        self.phase:='rootDisplay;
        foreach root in GetRoot():ChildViewFrames() do if root.viewCObject then begin
            self:pickerFonts(root);
            self:quickFonts(root);
            self:findQueryFonts(root);
            if self:findScope(root) and root.findAllList and root.findAllList.viewCObject then begin
                local view:=root.findAllList;local pieces:=self:drawingFonts(view.pieces,0,view.viewFont,nil);
                if pieces then self:rememberDisplay(view,'pieces,pieces);
            end;
        end;
        self.phase:='notes;self:noteFonts();
        self.phase:='calls;self:callFonts();
        self.phase:='titles;self:titleFonts(GetRoot());
        self.phase:='agenda;
        local calendar:=GetRoot().calendar;
        if not calendar or not calendar.viewCObject then return nil;
        local agenda:=calendar.AgendaView;
        if agenda and agenda.viewCObject then begin
            local pieces:=self:drawingFonts(agenda.pieces,0,agenda.viewFont,nil);
            if pieces then self:rememberDisplay(agenda,'pieces,pieces);
        end;
        local meeting:=calendar.MeetingNotes;
        local ruleView:=if meeting then meeting.RepeatingView else nil;
        if ruleView and ruleView.viewCObject and ruleView.MessageBox and
            GetGlobalVar('|ubxFontPart:UBX|):containsChinese(ruleView.MessageBox.text) then
                self:fontSlot(ruleView.MessageBox,'viewFont);
        // Native date-field pix arrays are handled by sharedTextFonts.
        // Keep entryFont native, so ISO digits and English suffixes such as
        // ongoing retain their ROM face while Chinese is composited by run.
    end,
    // Restore only owned style elements when another native renderer or package
    // has subsequently cloned an array. Never write an obsolete result model.
    restoredValue:func(now,original,replacement,depth) begin
        if now=replacement then return original;
        if depth>5 then return now;
        if IsArray(now) and IsArray(original) and IsArray(replacement) and
            Length(now)=Length(original) and Length(now)=Length(replacement) then begin
            local result:=nil;
            foreach index,item in replacement do if item<>original[index] then begin
                local value:=self:restoredValue(now[index],original[index],item,depth+1);
                if value<>now[index] then begin if not result then result:=Clone(now);result[index]:=value;end;
            end;
            return if result then result else now;
        end;
        if IsFrame(now) and IsFrame(original) and IsFrame(replacement) and replacement.font and
            now.font=replacement.font and original.font then begin
            local value:=Clone(now);value.font:=original.font;return value;
        end;
        return now;
    end,
    restoreChange:func(change,keepBase) begin
        local view:=change.view;local now:=view.(change.slot);
        // Diagnostic deactivation keeps the base font installed. Retaining an
        // equivalent heap descriptor here avoids reintroducing ROM-only fonts.
        if keepBase and change.display and (change.slot='viewFont or change.slot='entryFont) and
            now=change.replacement and self:descriptor(change.original) then return nil;
        local value:=self:restoredValue(now,change.original,change.replacement,0);
        if value<>now then begin
            if view.viewCObject and change.configValue then self:setSlot(view,change.slot,value)
            else if view.viewCObject and change.display then begin SetValue(view,change.slot,value);view:Dirty();end
            else if view.viewCObject then self:setSlot(view,change.slot,value)
            else view.(change.slot):=value;
            if not change.own and value=change.original then RemoveSlot(view,change.slot);
            // clTextView caches its drawing callback when opened. Recreate
            // only this label after restoring the ROM callback on removal.
            if view.viewCObject and change.slot='ViewDrawScript and now=self.folderTitleFn then begin
                view:Close();view:Open();
            end;
        end;
    end,
    setDisplayEnabled:func(enabled) begin
        // Internal diagnostic entry point; never a separate package or user UI.
        self.displayEnabled:=enabled;
        if enabled then self:apply()
        else for index:=Length(self.changes)-1 to 0 by -1 do
            if self.changes[index].display then begin
                local change:=self.changes[index];
                // Keep the undo record for a retained descriptor: a subsequent
                // whole-font removal still has to reset its native font cache.
                if not ((change.slot='viewFont or change.slot='entryFont) and
                    change.view.(change.slot)=change.replacement and self:descriptor(change.original)) then begin
                    self:restoreChange(change,true);RemoveSlot(self.changes,index);
                end;
            end;
    end,
});
