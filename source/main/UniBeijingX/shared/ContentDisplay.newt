                if ownCancel then context.PickCancelledScript:=cancel else RemoveSlot(context,'PickCancelledScript);
            end;
            if failure then Throw(failure.name,failure.data);
            if IsArray(source) and not context.popup then context.popup:=source;
            if hilite then SetValue(context,'hilite,hilite);
            picker:Open();
            // Region's ordinary close/removal paths must close the actual
            // replacement view before its callback owner can be deactivated.
            if region and region.geoPicker=view then region.geoPicker:=picker;
            if region and region.countryPicker=view then region.countryPicker:=picker;
            if not self.bitmapPickers then self.bitmapPickers:=[];
            AddArraySlot(self.bitmapPickers,{view:picker,locale:GetLocale().localeSym});
        end;
    end,
    pickerCancel:func() nil,
    closeBitmapPickers:func(all) begin
        if not self.bitmapPickers then return nil;
        for i:=Length(self.bitmapPickers)-1 to 0 by -1 do begin
            local item:=self.bitmapPickers[i];
            if all or not item.view.viewCObject or item.locale<>GetLocale().localeSym then begin
                if item.view.viewCObject then item.view:Close();
                RemoveSlot(self.bitmapPickers,i);
            end;
        end;
    end,
    folderTitleCallback:func() begin
        local s:=GetGlobalVar('|ubxNamesContent:UBX|);
        if s and not s.removing then
            if self.preallocatedContext='showBarText then s:folderTitleDraw(self)
            else s:radioTextDraw(self);
    end,
    folderSetupCallback:func() begin
        self:|ubxFolderSetup:UBX|();
        local s:=GetGlobalVar('|ubxNamesContent:UBX|);
        if s and not s.removing then begin
            local bounds:=Clone(self.viewBounds);
            self.width:=s:folderTitleWidth(self,bounds.bottom-bounds.top);
            bounds.left:=bounds.right-self.width;self.viewBounds:=bounds;
        end;
    end,
    radioTextDraw:func(view) begin
        local owner:=view:Parent();local box:=view:LocalBox();
        local style:={font:self:romanFont(owner.viewFont)};
        view:DrawShape(MakeRect(0,0,box.right,box.bottom),
            {transferMode:modeCOPY,fillPattern:vfWhite,penPattern:vfNone});
        local text:=MakeText(owner.text,0,0,box.right,box.bottom);
        local pieces:=self:styledTextDrawing(text,owner.viewFont,self:uiFont(owner.viewFont,box.bottom),style);
        view:DrawShape(if pieces then pieces else text,style);
    end,
    radioTextFont:func(view) begin
        if not IsString(view.text) or not self:descriptor(view.viewFont) or
            not GetGlobalVar('|ubxFontPart:UBX|):containsChinese(view.text) then return nil;
        // The native radio owns its indicator and a single text-only child.
        // Composite the label child, preserving the ROM indicator and Latin.
        local children:=view:ChildViewFrames();
        if Length(children)<>1 then return nil;
        local label:=children[0];
        if label.viewClass mod 65536=98 and not label.text and not label.ViewDrawScript then begin
            self:rememberDisplay(label,'ViewDrawScript,self.folderTitleFn);
            label:Close();label:Open();
        end;
    end,
    folderTitleDraw:func(view) begin
        local box:=view:LocalBox();local mode:=view.viewTransferMode;
        local drawing:={font:view.viewFont,justification:'center,transferMode:mode};
        view:DrawShape(MakeRect(0,0,box.right,box.bottom),{transferMode:modeCOPY,
            fillPattern:if mode=modeBIC then vfBlack else vfWhite,penPattern:vfNone});
        local display:=self:folderTitleInfo(view,box.bottom);
        local text:=MakeText(display.text,0,0,box.right,box.bottom);
        local pieces:=self:styledTextDrawing(text,view.viewFont,self:uiFont(view.viewFont,box.bottom),drawing);
        view:DrawShape(if pieces then pieces else text,drawing);
        // The native script draws only the rounded title's end caps.
