        end;
    end,
    pickerBitmap:func(text,font,height) begin
        local part:=GetGlobalVar('|ubxFontPart:UBX|);local roman:=self:romanFont(font);
        local fallback:=self:uiFont(font,nil);if not fallback then return nil;
        // MakeText's bottom coordinate is the baseline, not the bitmap edge.
        // A shared font baseline leaves all descenders inside the bitmap.
        local baseline:=Max(FontAscent(roman),FontAscent(fallback));
        local pieces:=[];local offset:=0;local width:=0;
        while offset<StrLen(text) do begin
            local start:=offset;local cjk:=part:displayCode(Ord(text[offset]));offset:=offset+1;
            while offset<StrLen(text) and (part:displayCode(Ord(text[offset])))=cjk do offset:=offset+1;
            local run:=SubStr(text,start,offset-start);local f:=if cjk then fallback else roman;
            local w:=StrFontWidth(run,f);local y:=baseline-FontAscent(f);
            AddArraySlot(pieces,{font:f});AddArraySlot(pieces,MakeText(run,width,y,width+w+1,baseline));width:=width+w;
        end;
        local bitmap:=MakeBitmap(Max(1,width+1),height,nil);DrawIntoBitmap(pieces,{},bitmap);
        local info:=GetShapeInfo(bitmap);local bytes:=info.rowbytes;
