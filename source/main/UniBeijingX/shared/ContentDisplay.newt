        // after SetupAbstracts. Materialize that same baseline before adapting
        // it, so the first draw and its undo state are both complete.
        if not view.viewStyle then
            view.(EnsureInternal('viewStyle)):=EnsureInternal({font:view.viewFont});
        if not IsFrame(view.viewStyle) then return nil;
        local font:=nil;
        if IsFrame(literals[3]) and IsFrame(literals[18]) and
            literals[3].font=9216 and literals[18].font=9216 and literals[26]=9216 then begin
            local copy:=Clone(method);copy.literals:=Clone(literals);
            font:=self:descriptor(9216);
            foreach index in [3,18] do begin
                local style:=Clone(literals[index]);style.font:=font;
                copy.literals[index]:=style;
            end;
            copy.literals[26]:=font;
            copy.literals[27]:=EnsureInternal('|ubxOverviewWidth:UBX|);
            self:rememberDisplay(view,'|ubxOverviewNative:UBX|,copy);
            self:rememberDisplay(view,'Abstract,self.overviewAbstractFn);changed:=true;
        end;
        if changed and view.cursor then begin
            // Rebuild the current page with an independent cursor. Abstract
            // increments hiliteCount, so restart that counter and preserve the
            // native selection state rather than moving it to a phantom row.
            local count:=view.hiliteCount;local index:=view.hilitedIndex;
            view.hiliteCount:=0;
            view:SetupAbstracts(view.cursor:Clone());
            view.hiliteCount:=count;view.hilitedIndex:=index;view:Dirty();
        end;
    end,
    noteFonts:func() begin
        local notes:=GetRoot().paperroll;
        if notes and notes.viewCObject then begin
            if notes.currentLayout='overview then self:overviewFonts(notes.layout)
            else self:paragraphFonts(notes.targetView);
        end;
    end,
    titleFonts:func(root) begin
        // Native title clocks are clTextView (98), not paragraph views.
        // Match their context and actual Unicode content, never app captions.
        local queue:=root:ChildViewFrames();local i:=0;
        while i<Length(queue) and i<450 do begin
            local v:=queue[i];i:=i+1;
            if v.viewCObject then begin
                if v.viewClass mod 65536=98 and v.preallocatedContext='title and
                    v.viewTransferMode=modeBIC and IsInteger(v._proto.viewFont) and
                    (IsInteger(v.viewFont) or GetFontFamilySym(v.viewFont)='|BeijingRegion:UBX|) and
                    GetGlobalVar('|ubxFontPart:UBX|):containsChinese(v.text) and
                    (not v.ViewDrawScript or v.ViewDrawScript=self.clockFn) then begin
                        local opening:=v.ViewDrawScript<>self.clockFn;
                        if opening then
                            self:rememberDisplay(v,'ViewDrawScript,self.clockFn);
                        local width:=self:clockRuns(v,nil)+1;
                        if width>v.viewBounds.right-v.viewBounds.left then begin
                            local bounds:=Clone(v.viewBounds);bounds.right:=bounds.left+width;
                            self:rememberDisplay(v,'viewBounds,bounds);
                        end;
                        // clTextView caches its drawing callback when opened;
                        // Dirty alone does not install a new script. Reopen
                        // this display-only clock once, retaining its text and
                        // original click handler, not the owning application.
                        if opening then begin v:Close();v:Open();end;
                end;
                // Title clocks live in the app's top bar. Avoid walking input
                // and editor subtrees just to discover an unrelated caption.
                if v:GlobalBox().top<16 and v.viewClass mod 65536<>81 then begin
                    local kids:=v:ChildViewFrames();
                    if kids then foreach child in kids do if child.viewCObject then AddArraySlot(queue,child);
                end;
            end;
        end;
    end,
    clockCallback:func() begin
        local s:=GetGlobalVar('|ubxNamesContent:UBX|);
        if s and not s.removing and s.displayEnabled then s:clockDraw(self);
    end,
    clockRuns:func(view,draw) begin
        local text:=view.text;local x:=0;local i:=0;
        local part:=GetGlobalVar('|ubxFontPart:UBX|);
        // The formal Region package also adapts Notes' clock to its own font.
        // Keep that registry state, but use the original title prototype for
        // Roman glyphs. Otherwise the two observers would fight each other.
        local roman:=view._proto.viewFont;
        local chinese:=EnsureInternal({family:'beijing,size:GetFontSize(view.viewFont),face:GetFontFace(view.viewFont)});
        while i<StrLen(text) do begin
            local start:=i;local cjk:=part:displayCode(Ord(text[i]));i:=i+1;
            while i<StrLen(text) and (part:displayCode(Ord(text[i])))=cjk do i:=i+1;
            local run:=SubStr(text,start,i-start);local font:=if cjk then chinese else roman;
            local width:=StrFontWidth(run,font);
            if draw then view:DrawShape(MakeText(run,x,0,x+width,view:LocalBox().bottom),
                {font:font,transferMode:modeBIC});
            x:=x+width;
        end;
        return x;
    end,
    clockDraw:func(view) begin
        if not IsString(view.text) or not IsInteger(view._proto.viewFont) then return nil;
        local box:=view:LocalBox();
        // clTextView's BIC drawing cannot erase old white glyphs on the black
        // bar. Repaint this view's own rectangle before drawing mixed runs.
        view:DrawShape(MakeRect(0,0,box.right,box.bottom),
            {transferMode:modeCOPY,fillPattern:vfBlack,penPattern:vfNone});
        self:clockRuns(view,true);
    end,
    installOverviewHook:func() begin
        local notes:=GetRoot().paperroll;
        if not notes or notes.ubxDisplayLayouts or not IsFrame(notes.allLayouts) or
            not IsFrame(notes.allLayouts.overview) then return nil;
        // ShowLayout defers RedoChildren. Adapt the actual page immediately
        // before its native drawing, including its lazily created viewStyle.
        notes.(EnsureInternal('ubxDisplayLayouts)):=notes.allLayouts;
        notes.(EnsureInternal('ubxDisplayLayoutsOwn)):=HasSlot(notes,'allLayouts);
        local hook:=Clone(self.overviewDraw);hook.argFrame:=nil;
        self.overviewDrawFn:=EnsureInternal(hook);
        local template:=EnsureInternal({ViewDrawScript:self.overviewDrawFn});
        template.(EnsureInternal('_proto)):=notes.allLayouts.overview;
        local layouts:=Clone(notes.allLayouts);layouts.(EnsureInternal('overview)):=template;
        self.overviewLayouts:=layouts;
        notes.(EnsureInternal('allLayouts)):=layouts;
        notes.(EnsureInternal('ubxDisplaySetup)):=notes.ViewSetupDoneScript;
        notes.(EnsureInternal('ubxDisplaySetupOwn)):=HasSlot(notes,'ViewSetupDoneScript);
        hook:=Clone(self.notesOpened);hook.argFrame:=nil;
        self.notesSetupFn:=EnsureInternal(hook);
        notes.(EnsureInternal('ViewSetupDoneScript)):=self.notesSetupFn;
    end,
    notesOpened:func() begin
        if self.ubxDisplaySetup then self:ubxDisplaySetup();
        local s:=GetGlobalVar('|ubxNamesContent:UBX|);
        if s and not s.removing then s:nativeKeyFonts();
        if s and s.displayEnabled and not s.removing then begin
            s:noteFonts();s:titleFonts(self);
        end;
    end,
    overviewDraw:func() begin
        local s:=GetGlobalVar('|ubxNamesContent:UBX|);
        if s and s.displayEnabled and not s.removing then s:overviewFonts(self);
        inherited:?ViewDrawScript();
    end,
    removeOverviewHook:func() begin
        local notes:=GetRoot().paperroll;
        if notes and notes.ubxDisplayLayouts then begin
            if notes.allLayouts=self.overviewLayouts then begin
                if notes.ubxDisplayLayoutsOwn then notes.allLayouts:=notes.ubxDisplayLayouts
                else RemoveSlot(notes,'allLayouts);
            end;
            RemoveSlot(notes,'ubxDisplayLayouts);RemoveSlot(notes,'ubxDisplayLayoutsOwn);
            if notes.ViewSetupDoneScript=self.notesSetupFn then begin
                if notes.ubxDisplaySetupOwn then notes.ViewSetupDoneScript:=notes.ubxDisplaySetup
                else RemoveSlot(notes,'ViewSetupDoneScript);
            end;
            RemoveSlot(notes,'ubxDisplaySetup);RemoveSlot(notes,'ubxDisplaySetupOwn);
        end;
    end,
    callFonts:func() begin
        local calls:=GetRoot().callapp;
        if not calls or not calls.viewCObject then return nil;
        local queue:=[calls];local index:=0;
        while index<Length(queue) and index<100 do begin
            local view:=queue[index];
            // The label's child is the editable call-log name. Do not change
            // the Name caption, phone controls, menus or reference callbacks.
            if IsString(view.label) and StrEqual(view.label,"Name") then
                self:paragraphFonts(view)
            else if view.viewClass mod 65536<>81 then begin
                local children:=view:ChildViewFrames();
                if children then foreach child in children do
                    if child.viewCObject then AddArraySlot(queue,child);
            end;
            index:=index+1;
        end;
    end,
    datePickerSlot:func(view,slot) begin
        local value:=self:uiFont(view.(slot),nil);
